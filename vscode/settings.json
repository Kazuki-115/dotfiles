{
    "files.autoSave": "afterDelay",
    "C_Cpp.default.compilerPath": "/opt/homebrew/bin/g++",
    "editor.minimap.enabled": true,
    "editor.lineNumbers": "on",
    "editor.renderLineHighlight": "line",
    "terminal.integrated.enableMultiLinePasteWarning": false,
    "editor.autoClosingBrackets": "never",
    "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
    "editor.autoClosingQuotes": "never",
    "markdown-pdf.executablePath": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
    "markdown-pdf.displayHeaderFooter": false,
    "editor.renderWhitespace": "all",
    "terminal.integrated.rightClickBehavior": "paste",
    "markdown-preview-enhanced.previewTheme": "atom-dark.css",
    "vim.easymotion": true,
    "vim.incsearch": true,
    "vim.useSystemClipboard": true,
    "vim.useCtrlKeys": true,
    "vim.hlsearch": true,
    "vim.insertModeKeyBindings": [
        { "before": [ "j", "j" ], "after": [ "<Esc>" ] }
    ],
    "vim.normalModeKeyBindingsNonRecursive": [
        { "before": ["o"], "after": ["o", "<Esc>"] },
        { "before": ["O"], "after": ["O", "<Esc>"] },
    ],
    "editor.pasteAs.preferences": [],
    "git.ignoreLegacyWarning": true,
    "C_Cpp.errorSquiggles": "enabled",
    "remote.SSH.enableOldLinux": true,
    "github.copilot.advanced": {},
    "accessibility.signals.terminalBell": {
        "sound": "off"
    },
    "accessibility.signals.terminalCommandFailed": {
        "sound": "off"
    },
    "accessibility.signals.terminalCommandSucceeded": {
        "sound": "off"
    },
    "accessibility.signals.terminalQuickFix": {
        "sound": "off"
    },
    "accessibility.signals.codeActionApplied": {
        "sound": "off"
    },
    "accessibility.signals.codeActionTriggered": {
        "sound": "off"
    },
    "accessibility.signals.editsKept": {
        "sound": "off"
    },
    "accessibility.signals.editsUndone": {
        "sound": "off"
    },
    "accessibility.signals.lineHasError": {
        "sound": "off"
    },
    "accessibility.signals.lineHasFoldedArea": {
        "sound": "off"
    },
    "accessibility.signals.lineHasInlineSuggestion": {
        "sound": "off"
    },
    "accessibility.signals.lineHasWarning": {
        "sound": "off"
    },
    "accessibility.signals.nextEditSuggestion": {
        "sound": "off"
    },
    "accessibility.signals.positionHasWarning": {
        "sound": "off"
    },
    "chat.disableAIFeatures": true,
    "git.suggestSmartCommit": false,
    "editor.semanticTokenColorCustomizations": {},
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": [
                    "markup.heading",
                    "markup.heading.markdown",
                    "entity.name.section.markdown",
                    "punctuation.definition.heading.markdown"
                ],
                "settings": {
                    "fontStyle": "bold"
                }
            }
        ]
    },
    "editor.language.colorizedBracketPairs": [],
    "workbench.colorTheme": "Visual Studio 2017 Dark - C++"
}
